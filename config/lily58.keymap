                                     EX_LT  &none          &none     EX_RT
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&trans     &kp F1 &kp F2 &kp F3 &kp F4 &kp F5                        &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&trans     NU_L1                                                     NU_R1                              &kp F12
&kp PSCRN  NU_L2                                                     NU_R2                              &kp C_PP
&trans     NU_L3                            &none          &none     NU_R3                              &trans
                                     NU_LT  &none          &none     NU_RT
            >;
        };

        sys_layer {
            display-name = "Sys";
            bindings = <
&bootloader     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &out OUT_USB &out OUT_BLE &trans &trans &trans &bt BT_CLR_ALL
&sys_reset      SY_L1                                                                 SY_R1                                   &sys_reset
&trans          SY_L2                                                                 SY_R2                                   &trans
&studio_unlock  SY_L3                                   &none          &none          SY_R3                                   &studio_unlock
                                                 SY_LT  &none          &none          SY_RT
            >;
        };

        extra_1 { status = "reserved"; };
        extra_2 { status = "reserved"; };
    };
};
