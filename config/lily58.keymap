        ext_layer {
            display-name = "Extend";
            bindings = <
&trans     &trans &trans &trans &trans &trans                        &trans &trans &trans &trans &trans &kp DEL
&trans     EX_L1                                                     EX_R1                             &kp DEL
&trans     EX_L2                                                     EX_R2                             &kp GRAVE
