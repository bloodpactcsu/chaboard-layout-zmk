/*
 * PLACEHOLDER. This file is in git, so it must never hold real passwords.
 * The real macros live in the MACROS_COMBOS_DTSI Actions secret; the build
 * writes that over this file before compiling.
 *
 * Same labels as the real file, so every keymap still builds without the
 * secret (pull requests, keymap-drawer). These all type nothing.
 */
/ {
    macros {
        main_pw: main_pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };
        console_pw: console_pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };
        sudo_pw: sudo_pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };
        admin_pw: admin_pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };

        /* non-secrets */
        fms_login: fms_login {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&kp W &kp S &kp L &kp RET>,
                <&kp S &kp S &kp H &kp SPACE &kp P &kp RET>,
                <&kp C &kp D &kp SPACE &kp FSLH &kp RET>;
        };

        cd_fix: cd_fix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&kp C &kp D &kp SPACE &kp F &kp I &kp X &kp FSLH &kp T &kp R &kp A &kp V &kp I &kp S &kp RET>,
                <&kp L &kp S &kp SPACE &kp MINUS &kp O &kp RET>;
        };
    };

    combos {
        compatible = "zmk,combos";
    };
};