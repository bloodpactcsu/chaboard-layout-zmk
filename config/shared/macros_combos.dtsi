/ {
    macros {
        main_pw: main_pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            // types:  magicTheGathering17_
            bindings = <&kp M &kp A &kp G &kp I &kp C &kp LS(T) &kp H &kp E
                        &kp LS(G) &kp A &kp T &kp H &kp E &kp R &kp I &kp N &kp G
                        &kp N1 &kp N7 &kp UNDER &kp RET>;
        };
        console_pw: console_pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            // types:  Junk0000
            bindings = <&kp LS(J) &kp U &kp N &kp K &kp N0 &kp N0 &kp N0 &kp N0 &kp RET>;
        };
        sudo_pw: sudo_pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            // types:  frigfurg
            bindings = <&kp F &kp R &kp I &kp G &kp F &kp U &kp R &kp G &kp RET>;
        };
        admin_pw: admin_pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            // types:  K4tp0ng
            bindings = <&kp LS(K) &kp N4 &kp T &kp P &kp N0 &kp N &kp G &kp RET>;
        };

       fms_login: fms_login {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&kp W &kp S &kp L &kp RET>,
                <&kp S &kp S &kp H &kp SPACE &kp P &kp RET>,
                <&kp C &kp D &kp SPACE &kp FSLH &kp RET>;
        };

        cd_fix: cd_fix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&kp C &kp D &kp SPACE &kp F &kp I &kp X &kp FSLH &kp T &kp R &kp A &kp V &kp I &kp S &kp RET>,
                <&kp L &kp S &kp SPACE &kp MINUS &kp O &kp RET>;
        };
    };

    combos {
        compatible = "zmk,combos";

    };
};